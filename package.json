{
  "name": "jules-mcp-ts",
  "version": "1.3.0",
  "description": "An MCP server implementation for orchestrating Google Jules as a remote coding agent from a local coding agent.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "files": [
    "build",
    "README.md",
    "LICENSE",
    "config.json",
    "llms-installation.md"
  ],
  "bin": {
    "jules-mcp": "./build/mcp-server/jules_mcp_server.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node build/mcp-server/jules_mcp_server.js",
    "dev": "tsx mcp-server/jules_mcp_server.ts",
    "mcp-client": "tsx src/mcp_client.ts",
    "jules": "tsx scripts/jules_cli.ts",
    "test": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "tsx": "^4.7.1",
    "typescript": "^5.6.3",
    "vitest": "^4.0.18"
  }
}
